{
  "name": "my-blog-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "My blog frontend monorepo",
  "scripts": {
    "blog:dev": "pnpm --filter @my-blog/blog dev",
    "blog:build": "pnpm --filter @my-blog/blog build",
    "admin:dev": "pnpm --filter @my-blog/admin dev",
    "admin:build": "pnpm --filter @my-blog/admin build",
    "dev": "pnpm --parallel run blog:dev admin:dev",
    "build": "pnpm run blog:build && pnpm run admin:build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
